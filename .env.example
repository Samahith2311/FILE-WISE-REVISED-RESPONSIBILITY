# Copy to .env and fill in. .env is git-ignored.
# local    = browser storage only, works offline (default)
# supabase = shared data and live updates across computers
VITE_DATA_BACKEND=local

# Supabase dashboard > Project Settings > API. Use the publishable (anon) key only.
# Never put the service role / secret key here or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
